---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.tsx';
import Masthead from '../components/Masthead.astro';
import Section from '../components/Section.astro';
import Experience from '../components/Experience.astro';
import Projects from '../components/Projects.astro';
import Stack from '../components/Stack.astro';
import Education from '../components/Education.astro';
import Contact from '../components/Contact.astro';
import { profile, values } from '../data/content';

const year = new Date().getFullYear();
---

<Layout>
  <Header client:load initials={profile.initials} />

  <main id="main">
    <Masthead />

    <Section id="profile" n="01" title="Profile" lead={profile.intro}>
      <div class="grid gap-x-10 gap-y-9 sm:grid-cols-3">
        {
          values.map((v, i) => (
            <div>
              <p class="meta text-accent dark:text-accent-dark">
                {String(i + 1).padStart(2, '0')}
              </p>
              <h3 class="mt-2 text-[0.95rem] font-medium">{v.title}</h3>
              <p class="mt-2 text-[0.9rem] leading-relaxed text-ink-2 dark:text-bone-2">{v.body}</p>
            </div>
          ))
        }
      </div>
    </Section>

    <Section id="work" n="02" title="Work">
      <Experience />
    </Section>

    <Section
      id="projects"
      n="03"
      title="Projects"
      lead="Personal work, described as it actually is rather than as it would sound best."
    >
      <Projects />
      <a
        href={profile.github}
        target="_blank"
        rel="noopener noreferrer"
        class="meta link-underline mt-8 inline-block text-accent dark:text-accent-dark"
      >
        More on GitHub &rarr;
      </a>
    </Section>

    <Section id="stack" n="04" title="Stack">
      <Stack />
    </Section>

    <Section id="education" n="05" title="Education">
      <Education />
    </Section>

    <Section
      id="contact"
      n="06"
      title="Contact"
      lead={`Looking for a 6-month end-of-studies internship, March to September 2027, in or around ${profile.location}.`}
    >
      <Contact />
    </Section>
  </main>

  <footer class="border-t border-rule dark:border-rule-dark">
    <div
      class="meta mx-auto flex max-w-6xl flex-wrap justify-between gap-4 px-6 py-8 text-ink-2 sm:px-10 dark:text-bone-2"
    >
      <span>&copy; {year} {profile.name}</span>
      <span>Astro &middot; React &middot; Tailwind &middot; set in Newsreader &amp; Geist</span>
    </div>
  </footer>
</Layout>
