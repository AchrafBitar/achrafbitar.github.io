---
import { experience } from '../data/content';
---

<ol class="relative space-y-10 border-l border-slate-200 pl-8 dark:border-slate-800">
  {
    experience.map((job) => (
      <li class="relative">
        <span
          class="absolute top-1.5 -left-[2.3rem] h-2.5 w-2.5 rounded-full bg-emerald-500 ring-4 ring-slate-50 dark:ring-slate-900"
          aria-hidden="true"
        />
        <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
          <h3 class="text-base font-semibold text-slate-900 dark:text-white">
            {job.role}
            <span class="font-normal text-emerald-700 dark:text-emerald-400"> · {job.company}</span>
          </h3>
          {
            job.period && (
              <span class="text-xs whitespace-nowrap text-slate-500 dark:text-slate-400">
                {job.period}
              </span>
            )
          }
        </div>
        <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">{job.context}</p>
        <ul class="mt-3 space-y-2">
          {job.bullets.map((b) => (
            <li class="flex gap-2.5 text-sm leading-relaxed text-slate-600 dark:text-slate-400">
              <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-emerald-500/70" aria-hidden="true" />
              <span>{b}</span>
            </li>
          ))}
        </ul>
      </li>
    ))
  }
</ol>
