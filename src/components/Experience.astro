---
import { experience, employerMarks } from '../data/content';
---

<div>
  {
    experience.map((job, i) => (
      <article
        class:list={[
          'grid gap-x-8 gap-y-4 py-10 sm:grid-cols-[6.5rem_1fr]',
          i > 0 && 'border-t border-rule dark:border-rule-dark',
        ]}
      >
        <div class="flex items-start gap-3 sm:flex-col sm:gap-4">
          <span
            class="meta flex h-11 w-11 shrink-0 items-center justify-center border border-rule text-ink-2 dark:border-rule-dark dark:text-bone-2"
            aria-hidden="true"
          >
            {employerMarks[job.company] ?? ''}
          </span>
          {job.period && <span class="meta pt-1 text-ink-2 sm:pt-0 dark:text-bone-2">{job.period}</span>}
        </div>

        <div>
          <h3 class="display text-2xl leading-tight font-medium sm:text-[1.75rem]">{job.role}</h3>
          <p class="mt-1.5 text-[0.95rem] text-accent dark:text-accent-dark">{job.company}</p>
          <p class="meta mt-3 text-ink-2 normal-case dark:text-bone-2" style="letter-spacing:0.04em">
            {job.context}
          </p>

          <ul class="mt-6 space-y-3.5">
            {job.bullets.map((b) => (
              <li class="grid grid-cols-[1.25rem_1fr] text-[0.95rem] leading-relaxed text-ink-2 dark:text-bone-2">
                <span class="text-accent/60 select-none dark:text-accent-dark/60" aria-hidden="true">
                  &mdash;
                </span>
                <span>{b}</span>
              </li>
            ))}
          </ul>
        </div>
      </article>
    ))
  }
</div>
