---
interface Props {
  id: string;
  n: string;
  title: string;
  lead?: string;
}
const { id, n, title, lead } = Astro.props;
---

<section id={id} class="border-t border-rule dark:border-rule-dark">
  <div class="mx-auto max-w-6xl px-6 py-20 sm:px-10 sm:py-28">
    <div class="grid gap-10 md:grid-cols-[7rem_1fr] md:gap-14">
      <div class="md:sticky md:top-24 md:self-start">
        <p class="meta text-accent dark:text-accent-dark">{n}</p>
        <p class="meta mt-1 text-ink-2 dark:text-bone-2">{title}</p>
      </div>
      <div>
        {
          lead && (
            <p class="display mb-12 max-w-2xl text-[clamp(1.5rem,3.2vw,2.15rem)] leading-[1.3] text-balance">
              {lead}
            </p>
          )
        }
        <slot />
      </div>
    </div>
  </div>
</section>
