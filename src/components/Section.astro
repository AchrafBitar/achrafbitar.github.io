---
interface Props {
  id: string;
  eyebrow?: string;
  title: string;
  lead?: string;
}
const { id, eyebrow, title, lead } = Astro.props;
---

<section id={id} class="border-t border-slate-200 py-20 dark:border-slate-800">
  <div class="mx-auto max-w-5xl px-6">
    {
      eyebrow && (
        <p class="mb-2 text-xs font-medium tracking-wider text-emerald-700 uppercase dark:text-emerald-400">
          {eyebrow}
        </p>
      )
    }
    <h2 class="font-serif text-3xl font-bold text-slate-900 dark:text-white">{title}</h2>
    {lead && <p class="mt-3 max-w-2xl text-slate-600 dark:text-slate-400">{lead}</p>}
    <div class="mt-10"><slot /></div>
  </div>
</section>
