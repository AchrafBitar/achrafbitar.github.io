---
import { profile } from '../data/content';

const items = [
  { k: 'Email', v: profile.email, href: `mailto:${profile.email}` },
  { k: 'LinkedIn', v: 'in/achrafbitar', href: profile.linkedin },
  { k: 'GitHub', v: 'AchrafBitar', href: profile.github },
];
---

<dl>
  {
    items.map((it, i) => (
      <div
        class:list={[
          'grid gap-x-8 gap-y-1 py-5 sm:grid-cols-[11rem_1fr]',
          i > 0 && 'border-t border-rule/70 dark:border-rule-dark/70',
        ]}
      >
        <dt class="meta pt-1.5 text-accent dark:text-accent-dark">{it.k}</dt>
        <dd>
          <a
            href={it.href}
            target={it.href.startsWith('mailto:') ? undefined : '_blank'}
            rel={it.href.startsWith('mailto:') ? undefined : 'noopener noreferrer'}
            class="display link-underline text-xl sm:text-2xl"
          >
            {it.v}
          </a>
        </dd>
      </div>
    ))
  }
</dl>
