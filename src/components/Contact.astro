---
import { Mail, Linkedin, Github } from 'lucide-react';
import { profile } from '../data/content';

const items = [
  { icon: Mail, label: profile.email, href: `mailto:${profile.email}` },
  { icon: Linkedin, label: 'linkedin.com/in/achrafbitar', href: profile.linkedin },
  { icon: Github, label: 'github.com/AchrafBitar', href: profile.github },
];
---

<div class="flex flex-col gap-3">
  {
    items.map(({ icon: Icon, label, href }) => (
      <a
        href={href}
        rel={href.startsWith('mailto:') ? undefined : 'noopener noreferrer'}
        target={href.startsWith('mailto:') ? undefined : '_blank'}
        class="inline-flex w-fit items-center gap-3 text-slate-600 transition-colors hover:text-emerald-700 dark:text-slate-400 dark:hover:text-emerald-400"
      >
        <Icon size={18} aria-hidden="true" />
        <span class="text-sm">{label}</span>
      </a>
    ))
  }
</div>
