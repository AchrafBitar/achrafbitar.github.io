---
import { expertise } from '../data/content';
---

<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
  {
    expertise.map((group) => (
      <div class="rounded-lg border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-800/40">
        <h3 class="text-sm font-semibold text-slate-900 dark:text-white">{group.title}</h3>
        <ul class="mt-3 flex flex-wrap gap-1.5">
          {group.skills.map((skill) => (
            <li class="rounded bg-slate-100 px-2 py-1 text-xs text-slate-600 dark:bg-slate-900/70 dark:text-slate-400">
              {skill}
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</div>
