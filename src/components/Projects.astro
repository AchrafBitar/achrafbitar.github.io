---
import { projects } from '../data/content';
---

<div>
  {
    projects.map((p, i) => (
      <article
        class:list={[
          'grid gap-x-8 gap-y-4 py-10 sm:grid-cols-[6.5rem_1fr]',
          i > 0 && 'border-t border-rule dark:border-rule-dark',
        ]}
      >
        <p class="display text-4xl leading-none text-rule dark:text-rule-dark" aria-hidden="true">
          {String(i + 1).padStart(2, '0')}
        </p>

        <div>
          <p class="meta text-accent dark:text-accent-dark">{p.label}</p>
          <h3 class="display mt-2 text-2xl leading-tight font-medium sm:text-[1.75rem]">
            {p.title}
          </h3>
          <p class="mt-4 max-w-2xl text-[0.95rem] leading-relaxed text-ink-2 dark:text-bone-2">
            {p.description}
          </p>
          <p class="meta mt-5 text-ink-2 dark:text-bone-2">{p.tags.join(' · ')}</p>
        </div>
      </article>
    ))
  }
</div>
