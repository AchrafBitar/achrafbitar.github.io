---
import { projects } from '../data/content';
---

<div class="grid gap-6 md:grid-cols-3">
  {
    projects.map((p) => (
      <article class="flex flex-col rounded-lg border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-800/40">
        <p class="text-xs font-medium tracking-wider text-emerald-700 uppercase dark:text-emerald-400">
          {p.label}
        </p>
        <h3 class="mt-2 text-base font-semibold text-slate-900 dark:text-white">{p.title}</h3>
        <p class="mt-3 flex-1 text-sm leading-relaxed text-slate-600 dark:text-slate-400">
          {p.description}
        </p>
        <ul class="mt-4 flex flex-wrap gap-1.5">
          {p.tags.map((t) => (
            <li class="rounded bg-slate-100 px-2 py-1 text-xs text-slate-600 dark:bg-slate-900/70 dark:text-slate-400">
              {t}
            </li>
          ))}
        </ul>
      </article>
    ))
  }
</div>
