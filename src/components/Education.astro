---
import { education } from '../data/content';
---

<div class="space-y-4">
  {
    education.map((e) => (
      <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 border-b border-slate-200 pb-4 last:border-0 dark:border-slate-800">
        <div>
          <h3 class="text-base font-semibold text-slate-900 dark:text-white">{e.school}</h3>
          <p class="text-sm text-slate-600 dark:text-slate-400">{e.degree}</p>
        </div>
        <span class="text-xs whitespace-nowrap text-slate-500 dark:text-slate-400">{e.period}</span>
      </div>
    ))
  }
</div>
