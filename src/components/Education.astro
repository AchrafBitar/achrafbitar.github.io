---
import { education } from '../data/content';
---

<div>
  {
    education.map((e, i) => (
      <div
        class:list={[
          'grid gap-x-8 gap-y-1 py-6 sm:grid-cols-[6.5rem_1fr]',
          i > 0 && 'border-t border-rule dark:border-rule-dark',
        ]}
      >
        <p class="meta pt-2 text-ink-2 dark:text-bone-2">{e.period}</p>
        <div>
          <h3 class="display text-xl leading-tight font-medium sm:text-2xl">{e.school}</h3>
          <p class="mt-1.5 text-[0.95rem] text-ink-2 dark:text-bone-2">{e.degree}</p>
        </div>
      </div>
    ))
  }
</div>
